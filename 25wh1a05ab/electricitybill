package mypackage5AB;

import java.util.Scanner;

public class Electricitybill {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner input =new Scanner(System.in);//creating scanner object
		System.out.println("enter the previous reading");
		int oldreading =input.nextInt();//converting incoming
		System.out.println("the old reading is "+oldreading);
		System.out.println("enter new reading");
		int newreading =input.nextInt();
		System.out.println("the new reading is "+newreading);
		int units=oldreading-newreading;
		System.out.println("the total units = "+units);
		double bill=0;
		if(units<50) {
			bill=50*1;
		}
		else if(units<100 && units>50 ) {
			bill= (50*1)+((units-50)*2);
		}
		else if(units>100 && units<200) {
			bill=50*1+50*2+(units-100)*3;
		}
		else if(units>200 && units<400) {
			bill=50*1+50*2+50*3+(units-150)*4;
		}
		else if(units>400) {
			bill=50*1+50*2+50*3+50*4+(units-200)*5;
		}
		System.out.println("the total bill is "+bill);
		
	}

}
